# Project Anna Remote Client - Vercel / Web Environment Variables
# These can be configured in your Vercel Project Settings > Environment Variables

# Cloudflare WebSocket Relay endpoint
VITE_CF_RELAY_URL=wss://ai-overtake-relay.gravitymarts.workers.dev/ws

# Shared Secret Token for authenticating connections
VITE_AUTH_SECRET=anna-secret-token-change-me

# Target PC Ethernet MAC Address for Wake-on-LAN (e.g. 74:56:3C:63:A9:9A)
VITE_TARGET_MAC=74:56:3C:63:A9:9A
